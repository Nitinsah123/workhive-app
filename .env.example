# ====================================================================
# WorkHive Environment Variables Configuration Template
# Copy this file to .env (which is git-ignored) to set your credentials:
# ====================================================================

# Google OAuth 2.0 Credentials for Live Gmail Delivery (Zero App Password Required)
# Setup in Google Cloud Console:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web Application)
# 3. Add Authorized Redirect URI:
#    http://localhost:8080/api/email-connections/gmail/callback
# 4. Fill in your Client ID and Client Secret below:
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/email-connections/gmail/callback

# Optional Frontend URL (Default: http://localhost:3000)
APP_FRONTEND_URL=http://localhost:3000
